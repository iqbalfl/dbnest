{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBnest",
  "version": "0.1.0",
  "identifier": "io.github.iqbalfl.dbnest",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBnest",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "publisher": "DBnest contributors",
    "homepage": "https://github.com/iqbalfl/dbnest",
    "shortDescription": "Server database lokal untuk Linux",
    "longDescription": "DBnest menjalankan PostgreSQL, MySQL, MariaDB, dan Redis secara native di Linux — banyak versi, banyak port, tanpa Docker dan tanpa root. Semua server hanya mendengarkan di 127.0.0.1 dan ditujukan untuk pengembangan lokal.",
    "linux": {
      "deb": {
        "section": "database"
      }
    }
  }
}
